# Frontend Dockerfile for Gemini Voice & Analytics Dashboard
FROM node:22-alpine AS builder

WORKDIR /app
COPY package*.json tsconfig.json vite.config.ts ./
RUN npm ci

COPY src/ ./src/
COPY index.html postcss.config.js tailwind.config.js ./
RUN npm run build

# Nginx runner for static frontend asset delivery
FROM nginx:alpine AS runner
COPY --from=builder /app/dist /usr/share/nginx/html

# Custom nginx configuration for SPA routing and reverse proxy
RUN echo 'server {' \
  '  listen 80;' \
  '  location / {' \
  '    root /usr/share/nginx/html;' \
  '    index index.html index.htm;' \
  '    try_files $uri $uri/ /index.html;' \
  '  }' \
  '  location /api/ {' \
  '    proxy_pass http://backend:5000/api/;' \
  '    proxy_http_version 1.1;' \
  '    proxy_set_header Upgrade $http_upgrade;' \
  '    proxy_set_header Connection "upgrade";' \
  '    proxy_set_header Host $host;' \
  '  }' \
  '  location /ws/ {' \
  '    proxy_pass http://backend:5000/ws/;' \
  '    proxy_http_version 1.1;' \
  '    proxy_set_header Upgrade $http_upgrade;' \
  '    proxy_set_header Connection "Upgrade";' \
  '    proxy_set_header Host $host;' \
  '  }' \
  '}' > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
